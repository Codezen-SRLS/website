---
// Card linking to an audit page; used on the home page, portfolio and related audits
import { Image } from "astro:assets";
import type { Audit } from "../lib/audits";

interface Props {
  audit: Audit;
  headingLevel?: "h2" | "h3";
  eager?: boolean;
}
const { audit, headingLevel = "h3", eager = false } = Astro.props;
const Heading = headingLevel;
const initials = audit.title
  .split(/\s+/)
  .slice(0, 3)
  .map((w) => w[0])
  .join("")
  .toUpperCase();
---

<a href={audit.path} class="acard">
  <div class="acard__media">
    {
      audit.logo ? (
        <Image
          src={audit.logo}
          alt=""
          widths={[320, 480, 640]}
          sizes="(max-width: 639px) 90vw, (max-width: 1023px) 45vw, 380px"
          loading={eager ? "eager" : "lazy"}
          class="acard__img"
        />
      ) : (
        <span class="acard__initials" aria-hidden="true">{initials}</span>
      )
    }
  </div>
  <div class="acard__body">
    <p class="mono acard__tag">
      {audit.description}{audit.partner && <span class="acard__partner"> · with {audit.partner}</span>}
    </p>
    <Heading class="acard__title">{audit.title}</Heading>
    <p class="mono acard__cta">↳ Read the audit</p>
  </div>
</a>

<style>
  .acard {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--glass-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--glass);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }
  .acard:hover {
    border-color: var(--border-accent);
    box-shadow: var(--glow-cyan);
    transform: translateY(-3px);
  }
  .acard__media {
    position: relative;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 45%, rgba(var(--rgb-cyan), 0.14), transparent 62%),
      radial-gradient(120% 120% at 80% 100%, rgba(var(--rgb-indigo), 0.4), transparent 60%);
  }
  .acard__media :global(.acard__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }
  .acard:hover .acard__media :global(.acard__img) {
    opacity: 1;
  }
  .acard__initials {
    font-family: var(--font-mono);
    font-size: 28px;
    letter-spacing: 0.05em;
    color: var(--cz-cyan-soft);
    opacity: 0.35;
  }
  .acard__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 18px 20px 22px;
    border-top: 1px solid var(--glass-line);
  }
  .acard__tag {
    margin: 0;
    color: var(--text-muted);
  }
  .acard__partner {
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .acard__title {
    flex: 1;
    margin: 10px 0 0;
    color: var(--text-strong);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
  }
  .acard__cta {
    margin: 12px 0 0;
    color: var(--text-accent);
  }
</style>

---
// Audit request form. Any element with [data-open-request] opens it. Sends through
// EmailJS with the same template parameters as the Gatsby site
// (from_name, from_email, project, message), so the EmailJS template keeps working.
import Button from "./ui/Button.astro";
---

<dialog id="request-dialog" class="rq" aria-labelledby="rq-title">
  <button type="button" class="rq__close" aria-label="Close" data-rq-close>
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </svg>
  </button>

  <div data-rq-form-view>
    <h2 id="rq-title" class="rq__title">Let's secure your project</h2>
    <p class="rq__lead">Share a few details and we'll get back within one business day.</p>
    <form class="rq__form" data-clarity-mask="True" novalidate>
      <div class="rq__field">
        <label for="rf-name">Name *</label>
        <input id="rf-name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
      </div>
      <div class="rq__field">
        <label for="rf-email">Email *</label>
        <input id="rf-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@project.xyz" />
      </div>
      <div class="rq__field">
        <label for="rf-project">Project / Protocol</label>
        <input id="rf-project" name="project" type="text" autocomplete="organization" placeholder="Protocol name & chain" />
      </div>
      <div class="rq__field">
        <label for="rf-details">Request Details</label>
        <textarea id="rf-details" name="details" rows="4" placeholder="Codebase, scope, timeline…"></textarea>
      </div>
      <p class="rq__error" role="alert" hidden data-rq-error>
        Your request wasn't sent. Try again, or email us at <a href="mailto:info@codezen.tech">info@codezen.tech</a>.
      </p>
      <Button type="submit" block data-rq-submit>Submit your request</Button>
      <p class="rq__note">
        We use your details only to reply to your request. See our <a href="/privacy-policy/">Privacy Policy</a>.
      </p>
    </form>
  </div>

  <div class="rq__done" hidden data-rq-done-view>
    <div class="rq__check" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M7 14.5l4.5 4.5L21 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>
    <h2 class="rq__title" tabindex="-1" data-rq-done-title>Request received</h2>
    <p class="rq__lead" data-rq-thanks></p>
    <Button variant="glass" size="md" arrow={false} data-rq-close>Close</Button>
  </div>
</dialog>


<style>
  .rq {
    width: min(540px, calc(100% - 32px));
    max-height: calc(100dvh - 48px);
    padding: 40px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-line-strong);
    background: rgba(12, 14, 23, 0.97);
    box-shadow: var(--shadow-float);
    color: var(--text-body);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .rq[open] {
    animation: czPop 0.3s var(--ease) both;
  }
  .rq::backdrop {
    background: var(--surface-overlay);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .rq__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--glass-line);
    background: var(--glass);
    color: var(--text-body);
    cursor: pointer;
  }
  .rq__close:hover {
    color: var(--text-strong);
    border-color: var(--border-accent);
  }
  .rq__title {
    margin: 0;
    padding-right: 48px;
    color: var(--text-strong);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .rq__title:focus {
    outline: none;
  }
  .rq__lead {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.6;
  }
  .rq__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 26px;
  }
  .rq__field label {
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .rq__field input,
  .rq__field textarea {
    display: block;
    width: 100%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-line);
    border-radius: var(--radius-sm);
    color: var(--text-strong);
    font-family: var(--font-body);
    /* 16px stops iOS Safari zooming into the field */
    font-size: 16px;
    padding: 12px 14px;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .rq__field textarea {
    resize: vertical;
    line-height: 1.5;
  }
  .rq__field input::placeholder,
  .rq__field textarea::placeholder {
    color: var(--text-muted);
  }
  .rq__field input:focus,
  .rq__field textarea:focus {
    outline: none;
    border-color: var(--cz-cyan);
    box-shadow: 0 0 0 3px rgba(var(--rgb-cyan), 0.18);
  }
  .rq__field [aria-invalid] {
    border-color: var(--status-danger);
  }
  .rq__error {
    margin: 0;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 92, 92, 0.4);
    background: rgba(255, 92, 92, 0.08);
    color: #ffd2d2;
    font-size: 14px;
    line-height: 1.5;
  }
  .rq__error a,
  .rq__note a {
    color: var(--cz-cyan-soft);
  }
  .rq__note {
    margin: 0;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .rq__done {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 24px 0;
    text-align: center;
  }
  .rq__done[hidden] {
    display: none;
  }
  .rq__done .rq__title {
    padding: 0;
    margin-top: 24px;
  }
  .rq__done .rq__lead {
    margin-bottom: 28px;
  }
  .rq__check {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid rgba(47, 212, 138, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--status-success);
    box-shadow: 0 0 28px -6px rgba(47, 212, 138, 0.5);
  }

  /* Full-screen sheet on phones */
  @media (max-width: 599px) {
    .rq {
      width: 100%;
      max-width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      padding: 28px 20px calc(28px + env(safe-area-inset-bottom));
      border-radius: 0;
      border: 0;
    }
  }
</style>

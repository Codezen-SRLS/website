---
import ethereum from "../../assets/icons/chains/ethereum.svg";
import solana from "../../assets/icons/chains/solana.svg";
import cosmos from "../../assets/icons/chains/cosmos.svg";
import polkadot from "../../assets/icons/chains/polkadot.svg";
import bitcoin from "../../assets/icons/chains/bitcoin.svg";

const CHAINS = [
  { src: ethereum.src, alt: "Ethereum", w: 80, h: 20 },
  { src: solana.src, alt: "Solana", w: 64, h: 16 },
  { src: cosmos.src, alt: "Cosmos", w: 107, h: 20 },
  { src: polkadot.src, alt: "Polkadot", w: 94, h: 20 },
  { src: bitcoin.src, alt: "Bitcoin", w: 96, h: 20 },
];
---

<div class="chains">
  <span class="chains__label">Audited on</span>
  <ul class="chains__list">
    {
      CHAINS.map((c) => (
        <li>
          <img src={c.src} alt={c.alt} width={c.w} height={c.h} style={`height:${c.h}px`} loading="lazy" decoding="async" />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .chains {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px 26px;
    flex-wrap: wrap;
    margin: 20px 0 64px;
  }
  .chains__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .chains__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px 26px;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chains img {
    display: block;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.5;
  }
  @media (max-width: 639px) {
    .chains {
      flex-direction: column;
      margin-top: 32px;
    }
  }
</style>

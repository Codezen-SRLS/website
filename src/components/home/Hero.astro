---
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Refraction from "./Refraction.astro";
import ChainStrip from "./ChainStrip.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow hero__glow--cyan" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--indigo" aria-hidden="true"></div>
  <div class="hero__grid" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <div>
        <div class="rise" style="animation-duration:.7s">
          <Eyebrow>Securing Web3 &amp; Blockchain</Eyebrow>
        </div>
        <h1 id="hero-title" class="hero__title">
          Every line in.<br /><span class="hero__shimmer">Every threat out.</span>
          <span class="sr-only"> Smart contract security audits by Codezen.</span>
        </h1>
      </div>
      <div class="rise" style="animation-delay:.2s">
        <p class="hero__lede">
          Smart-contract audits and blockchain consulting for decentralized systems, from Solidity to Rust to CosmWasm. We
          surface what attackers would.
        </p>
        <div class="hero__ctas">
          <Button request>Secure your project</Button>
          <Button href="/portfolio/" variant="ghost">View audit reports</Button>
        </div>
      </div>
    </div>
    <div class="hero__visual rise" style="animation-delay:.35s;animation-duration:1s">
      <Refraction />
    </div>
    <ChainStrip />
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* The glows bleed sideways past the viewport; clip only horizontally so they
       can still rise behind the header */
    overflow-x: clip;
  }
  .hero__glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero__glow--cyan {
    top: -260px;
    left: -120px;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(var(--rgb-cyan), 0.16), transparent 65%);
    filter: blur(20px);
    animation: czDrift 16s ease-in-out infinite;
  }
  .hero__glow--indigo {
    top: 20px;
    right: -200px;
    width: 760px;
    height: 760px;
    background: radial-gradient(circle, rgba(var(--rgb-indigo), 0.55), transparent 65%);
    filter: blur(30px);
    animation: czDrift 22s ease-in-out infinite reverse;
  }
  .hero__grid {
    position: absolute;
    inset: -100px 0 auto 0;
    height: 900px;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(70% 60% at 60% 35%, #000, transparent 75%);
    mask-image: radial-gradient(70% 60% at 60% 35%, #000, transparent 75%);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 28px;
  }
  .hero__copy {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px 40px;
    align-items: end;
  }
  /* Rise in on load. Transform only: the headline is the LCP element and must
     never start invisible */
  .rise {
    animation: heroRise 0.8s ease both;
  }
  @keyframes heroRise {
    from {
      transform: translateY(14px);
    }
    to {
      transform: none;
    }
  }
  .hero__title {
    margin: 18px 0 0;
    color: var(--text-strong);
    font-size: clamp(40px, min(5.4vw, 8.5vh), 72px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
    animation: heroRise 0.8s 0.1s ease both;
  }
  .hero__shimmer {
    background-image: linear-gradient(100deg, #04d9ff, #2ee2ff, #168ccd, #cfe9ff, #04d9ff);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: czShimmer 6s linear infinite;
  }
  .hero__lede {
    margin: 0;
    max-width: 500px;
    color: var(--text-body);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 22px;
  }
  .hero__visual {
    width: 100%;
    margin-top: 28px;
  }

  @media (max-width: 639px) {
    .hero__title {
      font-size: clamp(40px, 12vw, 56px);
    }
    /* Stacked, full-width actions; the ghost link centres under the primary */
    .hero__ctas :global(.cz-btn) {
      flex: 1 1 100%;
    }
    .hero__ctas {
      gap: 6px;
    }
    .hero__visual {
      margin-top: 40px;
    }
    .hero__glow--cyan {
      width: 380px;
      height: 380px;
    }
    .hero__glow--indigo {
      width: 460px;
      height: 460px;
      right: -240px;
    }
  }
</style>

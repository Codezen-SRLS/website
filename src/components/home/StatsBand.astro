---
import Stat from "../ui/Stat.astro";

interface Props {
  stats: { value: string; label: string }[];
}
const { stats } = Astro.props;
---

<div class="container">
  <hr class="hairline" />
  <dl class="stats" aria-label="Codezen in numbers">
    {stats.map((s) => <Stat value={s.value} label={s.label} />)}
  </dl>
  <hr class="hairline" />
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 0;
    padding: 34px 0;
  }
  @media (max-width: 899px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 20px;
    }
  }
</style>

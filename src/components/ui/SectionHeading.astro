---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow?: string;
  heading: string;
  align?: "start" | "center";
  id?: string;
}
const { eyebrow, heading, align = "start", id } = Astro.props;
---

<div class:list={["cz-section-heading", align === "center" && "cz-section-heading--center"]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2 id={id}>{heading}</h2>
</div>

---
import Base from "../layouts/Base.astro";
import AuditCard from "../components/AuditCard.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import { audits } from "../lib/audits";
import { abs, breadcrumbs } from "../lib/seo";

const PAGE_SIZE = 12;
const SUGGESTION_COUNT = 6;
// Tags too generic, or topics rather than technologies, to offer as chips
const EXCLUDED_CHIP_TAGS = new Set(["audit", "blockchain", "smart contract", "consensus"]);

const counts: Record<string, number> = {};
audits.forEach((a) =>
  (a.tags || []).forEach((t) => {
    if (!EXCLUDED_CHIP_TAGS.has(t.toLowerCase())) counts[t] = (counts[t] || 0) + 1;
  })
);
const suggestions = Object.keys(counts)
  .sort((a, b) => counts[b] - counts[a])
  .slice(0, SUGGESTION_COUNT);

// Search index for the client script: same fields and weights as src/lib/auditSearch.ts
const index = audits.map((a) => ({
  title: a.title,
  tags: a.tags || [],
  partner: a.partner || "",
  description: a.description || "",
  extendedDescription: a.extendedDescription || "",
}));

const jsonLd = [
  {
    "@type": "CollectionPage",
    "@id": `${abs("/portfolio/")}#page`,
    name: "Codezen smart contract and blockchain audit portfolio",
    url: abs("/portfolio/"),
    about: { "@id": "https://www.codezen.tech/#organization" },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: audits.length,
      itemListElement: audits.map((a, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: abs(a.path),
        name: `${a.title} Security Audit`,
      })),
    },
  },
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Portfolio", path: "/portfolio/" },
  ]),
];
---

<Base
  title="Smart Contract & Blockchain Audit Portfolio"
  description={`Browse ${audits.length} public security audits by Codezen: Stellar, Cosmos SDK, CosmWasm, Solana, EVM and Substrate protocols, with findings and full reports.`}
  jsonLd={jsonLd}
>
  <div class="container">
    <section class="intro" aria-labelledby="portfolio-title">
      <Eyebrow>Audit Portfolio</Eyebrow>
      <h1 id="portfolio-title" class="page-heading">
        {audits.length}+ audits across<br /><span class="iris-text">every major blockchain</span>
      </h1>
      <p class="page-lead">
        Smart contracts, consensus protocols, and runtime environments. A complete track record of security engagements
        across Solidity, Rust, Anchor, CosmWasm, and Substrate.
      </p>
    </section>

    <div role="search" class="search" aria-label="Search audits" hidden>
      <label for="audit-search" class="sr-only">Search audits</label>
      <div class="search__field">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="search__icon">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M13.5 13.5L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        <input
          id="audit-search"
          type="search"
          placeholder="Search by project, chain, language or partner"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
        />
        <button type="button" class="search__clear" aria-label="Clear search" hidden>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="search__chips" role="group" aria-label="Popular technologies">
        {suggestions.map((tag) => <button type="button" class="search__chip" aria-pressed="false" data-chip={tag}>{tag}</button>)}
      </div>
      <p class="search__status" role="status"></p>
    </div>

    <div class="empty" hidden>
      <p class="empty__title"></p>
      <p>Try a project name, a chain like Cosmos or Solana, or a language like Rust.</p>
      <button type="button" class="cz-btn cz-btn--md" data-clear>Clear search</button>
    </div>

    <h2 class="sr-only">All audits</h2>
    <!-- Every audit is in the HTML so crawlers and agents can follow each link;
         cards are only hidden by paging ("Load more") or by the search. -->
    <ul class="grid" data-page-size={PAGE_SIZE}>
      {
        audits.map((a, i) => (
          <li data-i={i}>
            <AuditCard audit={a} eager={i < 3} />
          </li>
        ))
      }
    </ul>

    <div class="more" hidden>
      <button type="button" class="cz-btn cz-btn--lg" data-more>Load more audits</button>
      <p class="more__all mono" hidden>All {audits.length} audits shown</p>
    </div>
  </div>

  <script type="application/json" id="audit-index" set:html={JSON.stringify(index).replace(/</g, "\\u003c")} />
</Base>

<script>
  import { searchAudits, type Searchable } from "../lib/auditSearch";

  const index: (Searchable & { i: number })[] = JSON.parse(document.getElementById("audit-index")!.textContent!).map(
    (a: Searchable, i: number) => ({ ...a, i })
  );
  const grid = document.querySelector<HTMLUListElement>(".grid")!;
  const items = Array.from(grid.querySelectorAll<HTMLLIElement>("li"));
  const input = document.getElementById("audit-search") as HTMLInputElement;
  const clear = document.querySelector<HTMLButtonElement>(".search__clear")!;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-chip]"));
  const status = document.querySelector<HTMLElement>(".search__status")!;
  const empty = document.querySelector<HTMLElement>(".empty")!;
  const more = document.querySelector<HTMLButtonElement>("[data-more]")!;
  const allShown = document.querySelector<HTMLElement>(".more__all")!;
  const pageSize = Number(grid.dataset.pageSize);
  let visible = pageSize;

  // Keep ?q= in the address bar so searches can be shared, without adding history entries
  const syncQueryToUrl = (query: string) => {
    const url = new URL(window.location.href);
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    window.history.replaceState(window.history.state, "", url);
  };

  const render = () => {
    const query = input.value.trim();
    const searching = query.length > 0;
    clear.hidden = !input.value;
    chips.forEach((c) => c.setAttribute("aria-pressed", String(query.toLowerCase() === c.dataset.chip!.toLowerCase())));

    if (searching) {
      const results = searchAudits(index, query);
      const shown = new Set(results.map((r) => r.i));
      // Matches first, in ranked order
      results.forEach((r) => grid.appendChild(items[r.i]));
      items.forEach((li, i) => (li.hidden = !shown.has(i)));
      if (results.length) {
        status.textContent = `${results.length} ${results.length === 1 ? "audit matches" : "audits match"} “${query}”`;
      } else {
        // The empty state shows this visually; announce it for screen readers
        const sr = document.createElement("span");
        sr.className = "sr-only";
        sr.textContent = `No audits match “${query}”`;
        status.replaceChildren(sr);
      }
      empty.hidden = results.length > 0;
      empty.querySelector(".empty__title")!.textContent = `No audits match “${query}”`;
      more.hidden = true;
      allShown.hidden = true;
    } else {
      items.forEach((li) => grid.appendChild(li));
      items.forEach((li, i) => (li.hidden = i >= visible));
      status.textContent = "";
      empty.hidden = true;
      more.hidden = visible >= items.length;
      allShown.hidden = visible < items.length;
    }
  };

  const setQuery = (value: string) => {
    input.value = value;
    syncQueryToUrl(value.trim());
    render();
  };

  input.addEventListener("input", () => {
    syncQueryToUrl(input.value.trim());
    render();
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && input.value) {
      e.preventDefault();
      setQuery("");
    }
  });
  clear.addEventListener("click", () => {
    setQuery("");
    input.focus();
  });
  document.querySelector("[data-clear]")!.addEventListener("click", () => setQuery(""));
  chips.forEach((c) =>
    c.addEventListener("click", () => {
      const tag = c.dataset.chip!;
      setQuery(input.value.trim().toLowerCase() === tag.toLowerCase() ? "" : tag);
    })
  );
  more.addEventListener("click", () => {
    const firstNew = items[visible];
    visible += pageSize;
    render();
    // Move focus to the first newly shown card so keyboard users continue from there
    firstNew?.querySelector("a")?.focus({ preventScroll: true });
  });

  const initial = new URLSearchParams(window.location.search).get("q");
  if (initial) input.value = initial;
  render();
  // Search and paging only exist once this script runs; without it every audit stays listed
  document.querySelector<HTMLElement>(".search")!.hidden = false;
  document.querySelector<HTMLElement>(".more")!.hidden = false;
</script>

<style>
  .intro {
    padding: 56px 0 48px;
  }
  .intro .page-heading {
    margin-top: 18px;
  }
  .search {
    margin-bottom: 32px;
  }
  .search__field {
    position: relative;
    max-width: 640px;
  }
  .search__icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }
  .search__field input {
    width: 100%;
    height: 52px;
    padding: 0 52px 0 48px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--glass-line-strong);
    background: var(--glass);
    color: var(--text-strong);
    font: inherit;
    font-size: 16px;
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }
  .search__field input::placeholder {
    color: var(--text-muted);
  }
  .search__field input:focus {
    outline: none;
    border-color: var(--cz-cyan);
    box-shadow: 0 0 0 3px rgba(var(--rgb-cyan), 0.18);
  }
  .search__field input::-webkit-search-cancel-button {
    display: none;
  }
  .search__clear {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--glass-2);
    color: var(--text-body);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .search__clear[hidden] {
    display: none;
  }
  .search__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .search__chip {
    min-height: 36px;
    padding: 4px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--glass-line);
    background: transparent;
    color: var(--text-body);
    font-size: 14px;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .search__chip:hover {
    border-color: var(--glass-line-strong);
    color: var(--text-strong);
  }
  .search__chip[aria-pressed="true"] {
    border-color: var(--cz-cyan);
    color: var(--cz-cyan-soft);
    background: rgba(var(--rgb-cyan), 0.08);
  }
  .search__status {
    min-height: 22px;
    margin: 16px 0 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .empty {
    padding: 40px 24px;
    margin-bottom: 80px;
    border-radius: var(--radius-lg);
    border: 1px dashed var(--glass-line-strong);
    text-align: center;
  }
  .empty[hidden] {
    display: none;
  }
  .empty p {
    margin: 8px 0 20px;
  }
  .empty .empty__title {
    margin: 0;
    color: var(--text-strong);
    font-size: var(--fs-body-lg);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid li[hidden] {
    display: none;
  }
  .search[hidden],
  .more[hidden] {
    display: none;
  }
  .more {
    display: flex;
    justify-content: center;
    padding: 48px 0 40px;
  }
  .more [hidden] {
    display: none;
  }
  .more__all {
    color: var(--text-muted);
  }
  @media (max-width: 639px) {
    .intro {
      padding: 32px 0 36px;
    }
    .grid {
      gap: 16px;
    }
  }
</style>
